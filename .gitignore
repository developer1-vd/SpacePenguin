# ---- Build trees ----------------------------------------------------------
# Qt installed by install-deps.sh / install-deps.ps1
.qt/
build/
build-*/
cmake-build-*/
out/
install/
*.build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
install_manifest.txt
_deps/

# ---- qmake / Qt Creator ----------------------------------------------------
.qmake.stash
*/*.qmake.stash
Makefile
*/*/Makefile
moc_*.cpp
moc_*.h
moc_predefs.h
ui_*.h
qrc_*.cpp
qrc_*.h
*.pro.user
*.pro.user.*
*.qmlproject
*.qmlc
.qmake.qmlcachetimestamp
.qmlcache
*.jinja.*
*.jinja.hpp
*.jinja.cpp
.qmlc.ini
config.*.cache
config.*.stamp

# ---- Qt WebEngine runtime / resources --------------------------------------
QtWebEngineProcess
QtWebEngineCore.resources
resources.pak
icudtl.dat
snapshot_blob.bin
v8_context_snapshot.bin
locales/
*.pak
qtwebengine_*.qrc

# Translations: keep sources (*.ts), ignore compiled catalogs
*.qm

# ---- Compiler / linker artifacts -------------------------------------------
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.gch
*.pch
*.idb
*.pdb
*.ilk
*.map
*.core
vgcore.*
# Core dumps: "core" or "core.<pid>" only, never sources such as core.cpp
core
core.[0-9]*

# ---- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
*.code-workspace
.clangd/
compile_flags.txt
.direnv/

# ---- Browser runtime data (never commit user profiles) ---------------------
/profile/
/user-data/
/data/
cookies.sqlite
cookies.sqlite-journal
history.sqlite
bookmarks.json
localstorage.sqlite
*.log

# ---- OS / misc -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*~

# ---- Kilo code data  ------------------------------------------------------
.kilo/

# ---- Packages and packaging leftovers --------------------------------------
# Everything the build-*.sh / build-windows.ps1 scripts produce goes to dist/,
# their downloaded tools (linuxdeploy) to .cache/.
dist/
.cache/
*.dmg
*.AppImage
*.appimage
*.zsync
*.deb
*.rpm
*.pkg.tar.*
*.flatpak
# An AppImage unpacked with --appimage-extract
squashfs-root/
# Arch makepkg (packaging/arch)
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.tar.gz
# Flatpak
.flatpak-builder/
/repo/
# Nix: nix build / nix-build output links
/result
/result-*
# Python virtual environments (aqtinstall)
.venv/
