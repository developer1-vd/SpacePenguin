#!/bin/sh
# Load SpacePenguin's AppArmor profile, so Chromium's sandbox works on systems
# that restrict unprivileged user namespaces (Ubuntu 23.10+).
set -e
if [ -x /sbin/apparmor_parser ] || [ -x /usr/sbin/apparmor_parser ]; then
    if [ -d /sys/kernel/security/apparmor ] && [ -f /etc/apparmor.d/spacepenguin ]; then
        apparmor_parser -r -T -W /etc/apparmor.d/spacepenguin || true
    fi
fi
exit 0
