#!/bin/sh
# Unload SpacePenguin's AppArmor profile when the package is removed.
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ] || [ "$1" = "0" ]; then
    if [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1; then
        echo 'profile spacepenguin flags=(unconfined) {}' | apparmor_parser -R 2>/dev/null || true
    fi
fi
exit 0
